{
  "name": "meeting-notes-distiller",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["backend", "frontend", "e2e"],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:e2e": "npm run test --workspace=e2e",
    "lint": "tsc --noEmit -p backend && tsc --noEmit -p frontend",
    "docs": "npm run docs --workspace=backend"
  }
}
